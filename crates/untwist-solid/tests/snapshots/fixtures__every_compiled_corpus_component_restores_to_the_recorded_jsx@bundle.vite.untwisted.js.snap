import { createSignal, Show } from "solid-js";
import Component from "./Component.jsx";

export default function Component5() {
  const [e, t] = createSignal([]);
  const [n, l] = createSignal("");
  let s = 0;
  const i = () => {
    if (n()) {
      t([...e(), {
        id: s++,
        text: n()
      }]);
      l("");
    }
  };
  return (
    <div class="todo">
      <input value={n()} onInput={(c) => l(c.currentTarget.value)} />
      <button class="add" onClick={i}>add</button>
      <Show when={e().length} fallback={<p>nothing to do</p>}>
        <ul>
          <Component each={e()}>
            {(a) => <li>{a.text}<button class="rm" onClick={() => t(e().filter((b) => b.id !== a.id))}>x</button></li>}
          </Component>
        </ul>
        <p>{e().length} left</p>
      </Show>
    </div>
  );
}
