import Show from "./Show.jsx";

function createSignal(v) {
  console.log("mine");
  return [() => "mine:" + v, () => {}];
}

function onMount(f) {
  console.log("my-mount");
}

export default function ZSigMod(props) {
  const [n] = createSignal(4);
  onMount();
  return (
    <div>
      <p>{n}</p>
      <Show when={props.flag}>kid</Show>
    </div>
  );
}
