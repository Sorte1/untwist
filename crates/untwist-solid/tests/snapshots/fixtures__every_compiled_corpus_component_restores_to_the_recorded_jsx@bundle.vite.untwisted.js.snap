import { createSignal } from "solid-js";
import Component2 from "./Component2.jsx";

export default function Component3() {
  const [e, t] = createSignal(0);
  return (
    <div class="parent">
      <Component2 label="static" />
      <Component2 label={`count ${e()}`} tone={(e() > 1) ? "hot" : undefined}>
        <em>child {e()}</em>
      </Component2>
      <Component2 label="text">plain text</Component2>
      <button onClick={() => t(e() + 1)}>more</button>
    </div>
  );
}
