==== Component6.svelte
<script>
	let n = $state([{
		id: 1,
		text: "write",
		done: false
	}]);

	let r = $state("");
	let i = 2;
	const s = $derived(n.filter((e) => !e.done).length);
</script>

<input placeholder="new todo" bind:value={r} />
<button class="add" onclick={function () {
        if (r) {
          n.push({
            id: i++,
            text: r,
            done: false
          });
          r = "";
        }
      }}>add</button>
<ul>
	{#each n as t (t.id)}
		<li class:done={t.done}>
			<input type="checkbox" bind:checked={t.done} /> {t.text} <button class="remove" onclick={() => {
          const e = t.id;
          n = n.filter((t) => t.id !== e);
          return;
        }}>x</button>
		</li>
	{/each}
</ul>
<p>{s} left</p>

<style>
	.done {
		text-decoration: line-through;
	}
</style>
