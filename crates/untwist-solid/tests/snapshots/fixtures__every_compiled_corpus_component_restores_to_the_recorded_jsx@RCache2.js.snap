==== Alpha.jsx
import { store, ids } from "./shared.jsx";

const idOf = k => {
  if (!ids.has(k)) ids.set(k, ids.size + 1);
  return ids.get(k);
};

export default function Alpha() {
  return <b onClick={store.bump}>{store.v()}:{idOf("alpha")}</b>;
}
