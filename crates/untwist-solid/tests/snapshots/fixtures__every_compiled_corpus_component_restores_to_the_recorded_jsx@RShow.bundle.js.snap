==== RShow.jsx
import Show from "./Show.jsx";
import For from "./For.jsx";

export default function RShow(props) {
  return (
    <div>
      <Show when={props.flag}>kid</Show>
      <For each={[1, 2, 3]}>{x => <li>{x}</li>}</For>
    </div>
  );
}
