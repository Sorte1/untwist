==== shared.jsx
import { createSignal } from "solid-js";

const makeStore = () => {
  const [v, set] = createSignal(0);
  return {
    v,
    bump: () => set(v() + 1)
  };
};

const store = makeStore();

const ids = new Map();

export { store, ids };
