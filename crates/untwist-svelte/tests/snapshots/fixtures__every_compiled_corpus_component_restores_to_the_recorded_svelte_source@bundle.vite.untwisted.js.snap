==== Bi.svelte
<script>
	let n = $state([{
		id: 1,
		text: "write",
		done: false
	}]);

	let r = $state("");
	let i = 2;
	const s = $derived(n.filter((v) => !v.done).length);

	function l() {
		if (r) {
			n.push({
				id: i++,
				text: r,
				done: false
			});
			r = "";
		}
	}

	function f(v) {
		n = n.filter((b) => b.id !== v);
	}
</script>

<input placeholder="new todo" bind:value={r} />
<button class="add" onclick={l}>add</button>
<ul>
	{#each n as b (b.id)}
		<li class:done={b.done}>
			<input type="checkbox" bind:checked={b.done} /> {b.text} <button class="remove" onclick={() => f(b.id)}>x</button>
		</li>
	{/each}
</ul>
<p>{s} left</p>

<style>
	.done {
		text-decoration: line-through;
	}
</style>
