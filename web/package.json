{
  "name": "untwist-web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "wasm": "node --experimental-strip-types --no-warnings scripts/wasm-pkg.ts",
    "dev": "vite",
    "build": "node --experimental-strip-types --no-warnings scripts/wasm-pkg.ts && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "size": "node --experimental-strip-types --no-warnings scripts/size.ts",
    "og-image": "node --experimental-strip-types --no-warnings scripts/og-image.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
