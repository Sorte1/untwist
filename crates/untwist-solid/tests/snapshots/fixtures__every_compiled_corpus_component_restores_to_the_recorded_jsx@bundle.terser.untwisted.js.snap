import { createSignal } from "solid-js";

export default function Component5() {
  const [e, t] = createSignal(0);
  return (
    <div>
      <p>Count: {e()}</p>
      <button onClick={() => t(e() + 1)}>+1</button>
    </div>
  );
}
==== Component9.jsx
import { createSignal } from "solid-js";

export default function Component9() {
  const [e, t] = createSignal(false);
  const [n, r] = createSignal(0);
  return (
    <div>
      {e() ? <b>on</b> : <i>off</i>}{(n() > 1) && <span>more than one</span>}{n() > 0 ? "positive" : "zero"}
      <button class="t" onClick={() => t(!e())}>toggle</button>
      <button class="n" onClick={() => r(n() + 1)}>inc</button>
    </div>
  );
}
