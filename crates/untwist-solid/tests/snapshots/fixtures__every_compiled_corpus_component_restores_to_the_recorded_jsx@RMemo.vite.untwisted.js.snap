import { createSignal } from "solid-js";

const fe = (e) => {
  console.log("wrapped");
  return e;
};

const I = (e) => fe(() => e());

export default function Component() {
  const [e, t] = createSignal(1);
  const s = I(() => e() * 2);
  return (
    <div>
      <p>{s}</p>
      <p>{I(() => e())()}</p>
      <button onClick={() => t(e() + 1)}>inc</button>
    </div>
  );
}
