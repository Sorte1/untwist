import { createSignal } from "solid-js";

export default function PropAttr() {
  const [v, setV] = createSignal("x");
  return (
    <div>
      <input value={v()} data-v={v()} />
      <my-element class="custom" prop:items={[1, 2]} attr:size={v()} />
      <button onClick={() => setV(v() + "y")}>more</button>
    </div>
  );
}
